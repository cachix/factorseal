{
  "manifest_version": 3,
  "name": "FactorSeal",
  "version": "0.1.0",
  "description": "Fill personal logins with approval in FactorSeal Desktop.",
  "permissions": [
    "nativeMessaging",
    "storage",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "core.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "factorseal@factorseal.dev",
      "strict_min_version": "129.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "128": "icon.png"
  }
}
