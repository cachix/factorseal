{
  "manifest_version": 3,
  "name": "FactorSeal",
  "version": "0.1.0",
  "description": "Save and fill logins with FactorSeal Desktop. Requires a compatible Desktop installation.",
  "incognito": "not_allowed",
  "permissions": [
    "nativeMessaging",
    "storage",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "core.js",
      "background.js"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "field.html",
        "notice.html"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "factorseal@factorseal.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "browsingActivity"
        ],
        "optional": [
          "technicalAndInteraction"
        ]
      }
    }
  },
  "icons": {
    "128": "icon.png"
  }
}
