{
  "manifest_version": 3,
  "minimum_chrome_version": "137",
  "name": "FactorSeal",
  "version": "0.1.0",
  "description": "Fill personal logins with approval in FactorSeal Desktop.",
  "permissions": [
    "nativeMessaging",
    "storage",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "key": "",
  "icons": {
    "128": "icon.png"
  }
}
