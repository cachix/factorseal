---
import Mark from '../components/Mark.astro';

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="factorseal-site-title" aria-label={`${siteTitle} home`}>
  <Mark class="factorseal-site-title__mark" />{siteTitle}
</a>

<style>
  .factorseal-site-title {
    align-items: center;
    color: var(--sl-color-white);
    display: flex;
    font-size: 1.25rem;
    font-weight: 600;
    gap: 0.4rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }

  .factorseal-site-title :global(.factorseal-site-title__mark) {
    display: block;
    height: 2rem;
    width: 2rem;
  }
</style>
