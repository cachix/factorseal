---
import TerminalFrame from '@cachix/site-kit/ui/TerminalFrame.astro';
import Icon from './Icon.astro';
---

<div class="sync" data-sync>
  <div class="sync-computer" data-sync-device>
    <TerminalFrame class="fs-window" title="FactorSeal">
      <iframe class="fs-live" title="FactorSeal on a computer" data-live data-src="/desktop/index.html?demo=computer"></iframe>
    </TerminalFrame>
  </div>
  <div class="phone" data-sync-device>
    <div class="phone__screen">
      <div class="phone__display">
        <iframe class="fs-live" title="FactorSeal on a phone" data-live data-min-width="360" data-src="/desktop/index.html?demo=phone"></iframe>
      </div>
    </div>
  </div>
  <template data-sync-packet><span class="sync-packet" aria-hidden="true"><Icon name="fs:lock" /><span></span></span></template>
</div>

<script>
  import { mountOnPageLoad } from '../../scripts/page';
  import { mountLive } from '../../scripts/live';
  import { mountSync } from '../../scripts/sync';

  mountOnPageLoad('[data-sync-device]', mountLive);
  mountOnPageLoad('[data-sync]', mountSync);
</script>
