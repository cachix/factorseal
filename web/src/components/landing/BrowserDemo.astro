---
import TerminalFrame from '@cachix/site-kit/ui/TerminalFrame.astro';
import appIcon from '../../../../assets/logo/factorseal-app-icon.svg?raw';
import mark from '../../../../assets/logo/factorseal-mark-ink.svg?raw';
import fieldHtml from '../../../../extensions/browser/field.html?raw';
import fieldJs from '../../../../extensions/browser/field.js?raw';
import inlineCss from '../../../../extensions/browser/inline.css?raw';
import labelsJs from '../../../../extensions/browser/labels.js?raw';
import popupCss from '../../../../extensions/browser/popup.css?raw';
import popupHtml from '../../../../extensions/browser/popup.html?raw';
import popupJs from '../../../../extensions/browser/popup.js?raw';
import { inlineSvg } from '../../lib/svg';

const api = '<style>html{overflow:hidden}</style><script>globalThis.browser = parent.factorsealExtension;</script>';
const extension = (html: string, files: Record<string, string>) =>
  Object.entries(files).reduce((page, [name, content]) => page.replace(name, () => content), html);
const popup = extension(popupHtml, {
  '<link rel="stylesheet" href="popup.css">': `<style>${popupCss}</style>`,
  'src="mark.svg"': `src="data:image/svg+xml,${encodeURIComponent(mark)}"`,
  '<script src="labels.js"></script>': `${api}<script>${labelsJs}</script>`,
  '<script src="popup.js"></script>': `<script>${popupJs}</script>`,
});
const field = extension(fieldHtml, {
  '<link rel="stylesheet" href="inline.css">': `<style>${inlineCss}</style>`,
  'src="mark.svg"': `src="data:image/svg+xml,${encodeURIComponent(mark)}"`,
  '<script src="field.js"></script>': `${api}<script>${fieldJs}</script>`,
});
---

<div class="browser-demo" data-browser>
  <TerminalFrame class="browser-frame">
    <span slot="header-title" class="browser-address">github.com/login</span>
    <button slot="header-end" type="button" class="browser-extension" data-extension aria-label="FactorSeal" aria-expanded="false" set:html={inlineSvg(appIcon)} />
    <div class="browser-page">
      <div class="browser-signin">
        <strong>Sign in</strong>
        <div class="browser-form">
          <span class="browser-label">Username</span>
          <span class="browser-input"><span data-username></span><iframe class="browser-field" title="Fill with FactorSeal" data-field={field}></iframe></span>
          <span class="browser-label">Password</span>
          <span class="browser-input"><span data-password></span><iframe class="browser-field" title="Fill with FactorSeal" data-field={field}></iframe></span>
          <span class="browser-submit">Sign in</span>
        </div>
      </div>
    </div>
    <iframe class="browser-popup" title="FactorSeal extension" data-popup={popup}></iframe>
  </TerminalFrame>
  <div class="browser-prompt">
    <iframe class="fs-live" title="FactorSeal fill request" data-live data-min-width="500" data-src="/desktop/index.html?demo=browser"></iframe>
  </div>
</div>

<script>
  import { mountBrowser } from '../../scripts/browser';
  import { mountLive } from '../../scripts/live';
  import { mountOnPageLoad } from '../../scripts/page';

  mountOnPageLoad('[data-browser]', mountLive);
  mountOnPageLoad('[data-browser]', mountBrowser);
</script>
