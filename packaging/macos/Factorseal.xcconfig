SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx
ARCHS = arm64
ALWAYS_SEARCH_USER_PATHS = NO
GENERATE_INFOPLIST_FILE = NO
// Keep MARKETING_VERSION equal to the version in Cargo.toml.
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

FACTORSEAL_VARIANT = desktop
FACTORSEAL_VARIANT[config=DebugCredentialExchange] = credential-exchange
FACTORSEAL_VARIANT[config=ReleaseCredentialExchange] = credential-exchange
MACOSX_DEPLOYMENT_TARGET = 14.0
MACOSX_DEPLOYMENT_TARGET[config=DebugCredentialExchange] = 26.0
MACOSX_DEPLOYMENT_TARGET[config=ReleaseCredentialExchange] = 26.0
FACTORSEAL_CARGO_FEATURES =
FACTORSEAL_CARGO_FEATURES[config=DebugCredentialExchange] = --features factorseal-desktop/apple-credential-exchange
FACTORSEAL_CARGO_FEATURES[config=ReleaseCredentialExchange] = --features factorseal-desktop/apple-credential-exchange

// Cargo output. cargo-build.sh builds into CARGO_TARGET_DIR and the targets
// copy their executables from CARGO_BIN_DIR.
RUST_TARGET = aarch64-apple-darwin
CARGO_PROFILE = release
CARGO_PROFILE[config=Debug] = dev
CARGO_PROFILE[config=DebugCredentialExchange] = dev
CARGO_PROFILE_DIR = release
CARGO_PROFILE_DIR[config=Debug] = debug
CARGO_PROFILE_DIR[config=DebugCredentialExchange] = debug
// The variants differ in deployment target and features, so each one keeps
// its own Cargo target directory.
CARGO_TARGET_DIR = $(SRCROOT)/../../target/xcode/$(FACTORSEAL_VARIANT)
CARGO_BIN_DIR = $(CARGO_TARGET_DIR)/$(RUST_TARGET)/$(CARGO_PROFILE_DIR)

DEVELOPMENT_TEAM = G767KSRK6R
CODE_SIGN_STYLE = Automatic
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
ENABLE_HARDENED_RUNTIME = YES
ENABLE_APP_SANDBOX = NO
// The Cargo target needs the source tree and the Nix daemon.
ENABLE_USER_SCRIPT_SANDBOXING = NO
STRIP_INSTALLED_PRODUCT = NO
COPY_PHASE_STRIP = NO
