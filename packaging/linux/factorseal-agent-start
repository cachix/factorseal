#!/bin/sh
set -eu

runtime_dir=${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required}/factorseal
password_file=$runtime_dir/session-password
default_socket=${XDG_DATA_HOME:-$HOME/.local/share}/factorseal/agent/agent.sock
socket=${FACTORSEAL_AGENT_SOCKET:-$default_socket}

cleanup() {
    rm -f "$password_file"
    # Leave nothing behind for units started later in this session; the
    # already-started agent keeps the value it was given.
    if [ -n "${FACTORSEAL_AGENT_SOCKET:-}" ]; then
        systemctl --user unset-environment FACTORSEAL_AGENT_SOCKET || true
    fi
}
# Installed before the prompt writes anything: a signal in that window would
# otherwise leave the plaintext password in the runtime directory.
trap cleanup EXIT HUP INT TERM

# Stop first: systemd removes RuntimeDirectory on stop, so writing the handoff
# file before a restart could erase it between the stop and start phases.
systemctl --user stop factorseal-agent.service || true
install -d -m 0700 "$runtime_dir"
umask 077
systemd-ask-password "Factorseal password" > "$password_file"

# The unit inherits nothing from this shell, so an overridden socket has to be
# handed to the user manager or the agent would serve the default path while
# this script waited on the other one.
if [ -n "${FACTORSEAL_AGENT_SOCKET:-}" ]; then
    systemctl --user set-environment "FACTORSEAL_AGENT_SOCKET=$FACTORSEAL_AGENT_SOCKET"
fi
systemctl --user start factorseal-agent.service
attempt=0
while [ ! -S "$socket" ] && [ "$attempt" -lt 100 ]; do
    attempt=$((attempt + 1))
    sleep 0.05
done
if [ ! -S "$socket" ]; then
    systemctl --user status factorseal-agent.service --no-pager >&2 || true
    echo "Factorseal agent did not become ready" >&2
    exit 1
fi
echo "Factorseal agent is ready at $socket"
